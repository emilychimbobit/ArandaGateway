{
  "openapi": "3.0.3",
  "info": {
    "title": "API-NE-GestionAranda (Gateway)",
    "description": "Puerta de enlace de la aplicación (App Service .NET) para Aranda Service Management. Expone solo las capacidades del MVP: consultar la clasificación fija con la que se registra, crear ticket, listar tickets abiertos, consultar detalle, anular, adjuntar archivos y revisar los equipos asignados. La identidad del colaborador se envía temporalmente en X-Collaborator-Username hasta integrar Microsoft Entra ID. Las rutas /admin/* del App Service no se publican acá a propósito: entregan la cookie de sesión viva de Aranda.",
    "version": "1.1.0"
  },
  "servers": [
    {
      "url": "https://ase-gestionaranda-dev.azurewebsites.net",
      "description": "App Service - ambiente DEV"
    }
  ],
  "tags": [
    {
      "name": "Tickets",
      "description": "Operaciones de tickets del colaborador"
    },
    {
      "name": "Equipos",
      "description": "Consulta de equipos asignados al colaborador"
    }
  ],
  "paths": {
    "/api/tickets": {
      "post": {
        "tags": ["Tickets"],
        "operationId": "CrearTicket",
        "summary": "Crea un incidente o requerimiento en Aranda (REQ_04)",
        "parameters": [
          {
            "$ref": "#/components/parameters/CollaboratorUsername"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudCrearTicket"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket creado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaCrearTicket"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProblemDetails"
          },
          "503": {
            "$ref": "#/components/responses/ProblemDetails"
          }
        }
      },
      "get": {
        "tags": ["Tickets"],
        "operationId": "ListarTicketsAbiertos",
        "summary": "Lista los tickets abiertos del colaborador (REQ_05)",
        "parameters": [
          {
            "$ref": "#/components/parameters/CollaboratorUsername"
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de tickets abiertos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RespuestaResumenTicket"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProblemDetails"
          },
          "404": {
            "description": "No se pudo identificar al colaborador"
          }
        }
      }
    },
    "/api/tickets/parametros-creacion": {
      "get": {
        "tags": ["Tickets"],
        "operationId": "ObtenerParametrosCreacion",
        "summary": "Lo que el gateway aplicará al crear el ticket (REQ_04)",
        "description": "Alimenta el resumen que el agente muestra antes de confirmar el registro: clasificación fija, prefijo del asunto y límites. La creación ya no los repite. No consulta Aranda ni requiere colaborador.",
        "responses": {
          "200": {
            "description": "Parámetros de creación vigentes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaParametrosCreacion"
                }
              }
            }
          }
        }
      }
    },
    "/api/tickets/{caseNumber}": {
      "get": {
        "tags": ["Tickets"],
        "operationId": "ObtenerDetalleTicket",
        "summary": "Consulta el estado de un ticket propio (REQ_07)",
        "parameters": [
          {
            "$ref": "#/components/parameters/CaseNumber"
          },
          {
            "$ref": "#/components/parameters/CollaboratorUsername"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalle del ticket",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaDetalleTicket"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProblemDetails"
          },
          "404": {
            "description": "Ticket inexistente o no propio"
          }
        }
      }
    },
    "/api/tickets/{caseNumber}/cancellation": {
      "post": {
        "tags": ["Tickets"],
        "operationId": "AnularTicket",
        "summary": "Anula un ticket propio (REQ_06)",
        "parameters": [
          {
            "$ref": "#/components/parameters/CaseNumber"
          },
          {
            "$ref": "#/components/parameters/CollaboratorUsername"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SolicitudAnularTicket"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket anulado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaAnularTicket"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProblemDetails"
          },
          "404": {
            "description": "Ticket inexistente o no propio"
          },
          "409": {
            "$ref": "#/components/responses/ProblemDetails"
          },
          "503": {
            "$ref": "#/components/responses/ProblemDetails"
          }
        }
      }
    },
    "/api/tickets/{caseNumber}/attachments": {
      "post": {
        "tags": ["Tickets"],
        "operationId": "AdjuntarArchivoTicket",
        "summary": "Adjunta un archivo a un ticket propio (REQ_04)",
        "parameters": [
          {
            "$ref": "#/components/parameters/CaseNumber"
          },
          {
            "$ref": "#/components/parameters/CollaboratorUsername"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "Archivo permitido: xlsx, docx, ppt, pdf, png, jpg"
                  },
                  "description": {
                    "type": "string",
                    "description": "Descripción opcional del adjunto"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado del adjunto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RespuestaAdjuntarArchivo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProblemDetails"
          },
          "404": {
            "description": "Ticket inexistente o no propio"
          }
        }
      }
    },
    "/api/equipos": {
      "get": {
        "tags": ["Equipos"],
        "operationId": "ListarEquiposAsignados",
        "summary": "Revisión de equipos asignados al colaborador (REQ_10)",
        "description": "Consulta en el inventario/CMDB de Aranda los equipos asociados al colaborador autenticado. Solo expone tipo, modelo, código y estado.",
        "parameters": [
          {
            "$ref": "#/components/parameters/CollaboratorUsername"
          }
        ],
        "responses": {
          "200": {
            "description": "Listado de equipos asignados, o el aviso de que no hay registros asociados.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RespuestaEquipo"
                      }
                    },
                    {
                      "$ref": "#/components/schemas/RespuestaSinEquipos"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ProblemDetails"
          },
          "503": {
            "$ref": "#/components/responses/ProblemDetails"
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "CollaboratorUsername": {
        "name": "X-Collaborator-Username",
        "in": "header",
        "required": true,
        "description": "Identidad temporal del colaborador mientras se integra Microsoft Entra ID.",
        "schema": {
          "type": "string"
        }
      },
      "CaseNumber": {
        "name": "caseNumber",
        "in": "path",
        "required": true,
        "description": "Número de caso tal como lo devuelven la creación y el listado.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "ProblemDetails": {
        "description": "Error con formato ProblemDetails",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    },
    "schemas": {
      "TicketKind": {
        "type": "string",
        "enum": ["Incident", "ServiceRequest"],
        "description": "Tipo de ticket: incidente o requerimiento."
      },
      "SolicitudCrearTicket": {
        "type": "object",
        "required": ["type", "subject", "description"],
        "properties": {
          "type": {
            "$ref": "#/components/schemas/TicketKind"
          },
          "subject": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400,
            "description": "Asunto del ticket. Los 400 caracteres son el límite real de Aranda, medido el 16 de septiembre de 2026: con 401 responde 500 sin decir qué campo sobra. La gateway lo mide ya con el prefijo puesto y codificado, así que un asunto cercano al tope puede rechazarse con 400."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000,
            "description": "Descripción del ticket. Aranda no la limita —acepta 100 000 caracteres—; los 20 000 son política de la gateway y se configuran en Aranda:MaxDescriptionLength."
          }
        }
      },
      "RespuestaCrearTicket": {
        "type": "object",
        "properties": {
          "caseNumber": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "RespuestaParametrosCreacion": {
        "type": "object",
        "description": "Todo lo que el gateway aplica sin que el colaborador lo escriba. Se consulta antes de crear, para el resumen de confirmación.",
        "properties": {
          "clasificacion": {
            "$ref": "#/components/schemas/RespuestaClasificacionTicket"
          },
          "prefijoAsunto": {
            "type": "string",
            "nullable": true,
            "example": "[PRUEBA BOT]",
            "description": "Prefijo que se antepone al asunto. Nulo cuando no hay ninguno configurado: el asunto va tal cual."
          },
          "limites": {
            "$ref": "#/components/schemas/RespuestaLimitesTicket"
          }
        }
      },
      "RespuestaLimitesTicket": {
        "type": "object",
        "description": "Límites que la creación hace cumplir, para que el agente recorte antes de llamar en vez de descubrirlos con un 400.",
        "properties": {
          "maxAsunto": {
            "type": "integer",
            "example": 400,
            "description": "Máximo del asunto ya prefijado y codificado, no del texto que escribe el colaborador."
          },
          "maxDescripcion": {
            "type": "integer",
            "example": 20000
          },
          "maxBytesAdjunto": {
            "type": "integer",
            "format": "int64",
            "example": 3145728
          },
          "extensionesPermitidas": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [".docx", ".jpg", ".pdf", ".png", ".ppt", ".xlsx"]
          }
        }
      },
      "RespuestaClasificacionTicket": {
        "type": "object",
        "description": "Clasificación fija del REQ_04 aplicada al ticket.",
        "properties": {
          "servicio": {
            "type": "string",
            "example": "Por categorizar"
          },
          "impacto": {
            "type": "string",
            "example": "Bajo"
          },
          "urgencia": {
            "type": "string",
            "example": "Bajo"
          },
          "categoria": {
            "type": "string",
            "example": "Ticket creado por bot"
          },
          "grupo": {
            "type": "string",
            "example": "Mesa de Ayuda"
          }
        }
      },
      "RespuestaResumenTicket": {
        "type": "object",
        "properties": {
          "caseNumber": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "openedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RespuestaDetalleTicket": {
        "type": "object",
        "properties": {
          "caseNumber": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "resolverGroup": {
            "type": "string",
            "nullable": true
          },
          "lastUpdatedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "solution": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "SolicitudAnularTicket": {
        "type": "object",
        "required": ["reason", "confirmed"],
        "properties": {
          "reason": {
            "type": "string",
            "description": "Motivo de anulación (no vacío)"
          },
          "confirmed": {
            "type": "boolean",
            "description": "Confirmación explícita del colaborador"
          }
        }
      },
      "RespuestaAnularTicket": {
        "type": "object",
        "properties": {
          "caseNumber": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "RespuestaAdjuntarArchivo": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string"
          },
          "uploaded": {
            "type": "boolean"
          }
        }
      },
      "RespuestaEquipo": {
        "type": "object",
        "required": ["tipo", "modelo", "codigo", "estado"],
        "properties": {
          "tipo": {
            "type": "string",
            "description": "Categoría del equipo en la CMDB, por ejemplo LAPTOP MARCOBRE."
          },
          "modelo": {
            "type": "string",
            "description": "Nombre del elemento de configuración."
          },
          "codigo": {
            "type": "string",
            "description": "Código o serie del equipo."
          },
          "estado": {
            "type": "string",
            "description": "Estado del equipo en la CMDB, por ejemplo Asignado."
          }
        }
      },
      "RespuestaSinEquipos": {
        "type": "object",
        "description": "Respuesta cuando el colaborador no tiene equipos asociados.",
        "required": ["mensaje", "total", "data"],
        "properties": {
          "mensaje": {
            "type": "string",
            "example": "Sin registros asociados"
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "example": 0
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RespuestaEquipo"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          }
        }
      }
    }
  }
}
